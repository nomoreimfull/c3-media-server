# Default project configuration for the ESP32-C3 DLNA media server.
# Override anything here via `idf.py menuconfig`.

CONFIG_IDF_TARGET="esp32c3"

# --- Flash: XIAO ESP32-C3 has 4 MB ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- Partition table ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- CPU: run the single core flat out ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# --- HTTP server: room for streaming + DLNA + WebDAV handlers ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# --- FATFS: long filenames on the SD card ---
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# --- lwIP: socket pool. httpd claims up to max_open_sockets (13, set in
#     http_server.c) which must stay <= this minus 3; the rest cover SSDP/mDNS.
#     Headroom lets a file manager's thumbnail-scan burst not starve a WebDAV
#     upload. NOTE: sdkconfig.defaults only seeds a FRESH config — on an existing
#     checkout set it via `idf.py menuconfig` (Component config -> LWIP -> Max
#     number of open sockets = 16) or delete sdkconfig and rebuild. ---
CONFIG_LWIP_MAX_SOCKETS=16

# --- lwIP TCP window/buffers: the main streaming-throughput lever. Bigger send
#     buffer + receive window = more bytes in flight before waiting for ACKs.
#     (~16 KB, multiples of the 1440-byte MSS.) NOTE: sdkconfig.defaults only seeds
#     a FRESH config — apply to an existing checkout via `idf.py menuconfig`
#     (Component config -> LWIP -> TCP) or by deleting sdkconfig and rebuilding. ---
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCP_MSS=1440

# --- WiFi throughput: bigger TX/RX buffers help the ~15-20 Mbit/s ceiling ---
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

# --- Main task stack (app_main does mount + server bring-up) ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
